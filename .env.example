# Variáveis de ambiente — MODELO (sem valores reais)
# Copie este arquivo como ".env.local" e preencha com os valores reais.
# O arquivo ".env.local" NUNCA deve ser enviado ao GitHub.
# Os valores reais ficam no painel do Vercel em produção.

# ─── Supabase ───────────────────────────────────────────────────────────────
# Encontre em: supabase.com → seu projeto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-de-servico-aqui

# ─── Resend (serviço de e-mail) ──────────────────────────────────────────────
# Encontre em: resend.com → API Keys
RESEND_API_KEY=re_sua-chave-aqui

# ─── E-mail padrão dos formulários ──────────────────────────────────────────
# Destinatário inicial de todos os formulários (alterável individualmente pelo painel)
FORM_DEFAULT_RECIPIENT=contato@quimicosjc.org.br

# ─── URL do site ─────────────────────────────────────────────────────────────
# Em desenvolvimento: http://localhost:3000
# Em produção: https://quimicosjc.org.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Segredo para autenticação interna ──────────────────────────────────────
# Gere um valor aleatório forte: rode "openssl rand -base64 32" no terminal
AUTH_SECRET=gere-um-valor-secreto-aleatorio-aqui
